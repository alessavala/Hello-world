# Copy this file to .env and fill in the values from your Shopify Partner app.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_customers,read_discounts,write_discounts,read_orders,read_products
HOST=
SHOPIFY_APP_URL=

# Prisma / database. SQLite is fine for local dev; use Postgres/MySQL in production.
DATABASE_URL="file:./dev.sqlite"

# Reward defaults, used the first time a shop installs the app (can be edited in the app settings screen).
DEFAULT_REFERRER_REWARD_PERCENT=10
DEFAULT_REFEREE_REWARD_PERCENT=10
