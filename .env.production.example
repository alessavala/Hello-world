# Copy this to .env on the server (same directory as docker-compose.prod.yml)
# and fill in real values. Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=creator
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_DB=creator_commerce

# --- Backend ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# --- Domains ---
# Both must already have DNS A records pointing at this server's IP before
# starting the stack, or Caddy won't be able to issue HTTPS certificates.
FRONTEND_DOMAIN=tudominio.com
API_DOMAIN=api.tudominio.com
FRONTEND_URL=https://tudominio.com
API_URL=https://api.tudominio.com

# --- Email notifications (optional) ---
# Without SMTP_HOST, the backend just logs notification emails instead of
# sending them - the app works fine without this configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Creator Commerce <no-reply@tudominio.com>"

# --- Login social (opcional) ---
# Sin esto, los botones de Google/Facebook simplemente no aparecen en el
# frontend. Ver "Login social" en creator-commerce-backend/README.md para
# los pasos de cómo generar estos valores en Google Cloud Console / Meta for
# Developers.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
