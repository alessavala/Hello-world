# Copy this to .env on the server (same directory as docker-compose.prod.yml)
# and fill in real values. Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=creator
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_DB=creator_commerce

# --- Backend ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# --- Domains ---
# Both must already have DNS A records pointing at this server's IP before
# starting the stack, or Caddy won't be able to issue HTTPS certificates.
FRONTEND_DOMAIN=tudominio.com
API_DOMAIN=api.tudominio.com
FRONTEND_URL=https://tudominio.com
API_URL=https://api.tudominio.com
