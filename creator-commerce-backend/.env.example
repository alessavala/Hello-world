DATABASE_URL="postgresql://creator:creator@localhost:5432/creator_commerce?schema=public"
JWT_SECRET="replace-this-with-at-least-32-random-characters"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

